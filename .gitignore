# Obsidian vault files
.obsidian/

# macOS
.DS_Store
.AppleDouble
.LSOverride
*.swp
*.swo
*~
.vscode/

# Environment files
.env
.env.local
.env.*.local

# Node/npm
node_modules/
yarn.lock
# Note: package-lock.json is intentionally tracked for reproducible CI builds (npm ci)

# IDE
.idea/
*.sublime-project
*.sublime-workspace

# Quartz build output
public/
.quartz-cache/

# Temporary files
*.tmp
*.temp
*.log

# Claude Code internal artifacts
.claude/worktrees/
.claude/skills/*
.superpowers/

# Claude context files — ignore in subdirectories, keep root CLAUDE.md
**/CLAUDE.md
!/CLAUDE.md

# Graphify — knowledge graph generator (env file + generated output)
.graphify-env
graphify-out/

# Recording artifacts — large A/V captures from YouTube/video production.
# Keep these out of git (they're big binaries, e.g. a 66MB dispatch .wav).
# Transcripts (.srt) and rendered images (.png) are committed normally.
*.wav
*.mp3
*.m4a
*.mp4
*.mov
*.mkv
